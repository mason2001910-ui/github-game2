; Engine configuration file.
; Moonlight Rally: an original volleyball and money-skills mini game.
config_version=5

[application]

config/name="月光球場 Moonlight Rally"
run/main_scene="res://scenes/main.tscn"
config/icon="res://assets/moonlight-icon.svg"
boot_splash/image="res://assets/dreamcourt-preview.png"
boot_splash/fullsize=true
boot_splash/use_filter=true
config/features=PackedStringArray("4.7", "GL Compatibility")
config/description="小學生也能玩的排球與理財夢境冒險。"

[display]

window/size/viewport_width=1440
window/size/viewport_height=900
window/size/window_width_override=1440
window/size/window_height_override=900
window/stretch/mode="canvas_items"
window/handheld/orientation=1

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
environment/defaults/default_clear_color=Color(0.025, 0.035, 0.075, 1)

